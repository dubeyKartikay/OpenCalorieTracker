{
  "expo": {
    "name": "OpenCalorieTracker",
    "slug": "open-calorie-tracker",
    "version": "0.1.0",
    "scheme": "opencalorietracker",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a1b26",
    "ios": {
      "bundleIdentifier": "org.opencalorietracker.app",
      "supportsTablet": true
    },
    "android": {
      "package": "org.opencalorietracker.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow OpenCalorieTracker to take meal or nutrition label photos only when you choose camera capture.",
          "photosPermission": "Allow OpenCalorieTracker to pick a meal or nutrition label photo only when you choose photo upload."
        }
      ],
      "./modules/oct-health/app.plugin.js",
      "./modules/oct-barcode-scanner/app.plugin.js",
      "./modules/oct-speech/app.plugin.js",
      "./plugins/withWindowsCmake.js",
      "expo-status-bar",
      "expo-asset",
      "expo-secure-store",
      "expo-font"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
