# Optional pre-registered OpenAI "Sign in with ChatGPT" OAuth client ID (public PKCE client, no secret).
# Leave blank to use OpenAI Dynamic Client Registration (`dynamic_agent_client`) automatically.
# When pre-registration is available, register redirect URI: http://127.0.0.1/callback (loopback ephemeral port per RFC 8252).
EXPO_PUBLIC_OPENAI_OAUTH_CLIENT_ID=
